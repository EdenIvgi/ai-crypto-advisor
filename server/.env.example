# Copy to server/.env and fill in. Every variable here is validated at boot by
# src/config/env.js, which exits with a readable message if something is missing.

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=4000

# Exact origin of the frontend. Used for the CORS policy, so it must match the browser's
# origin character for character — no trailing slash.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string. Required in production. Leave it unset in development and the
# server starts a throwaway in-memory MongoDB instead, so a fresh clone runs with no setup —
# but everything you save disappears when the process stops.
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/ai-crypto-advisor

# Secret used to sign session tokens. Required in production, at least 32 characters.
# Unset in development, a random one is generated per process, so sessions end at restart.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=

# Optional everywhere, including production. CoinGecko's public tier needs no key; a free
# demo key from coingecko.com just raises the allowance, which is counted per IP address —
# and a cloud host shares its address with strangers. Without one, prices still work and fall
# back to the last good response, then to sample data, if the allowance runs out.
# COINGECKO_API_KEY=
